<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="CollegeDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CollegeDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- Authentication: who are you? -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Dashboard.aspx"
             timeout="20" slidingExpiration="true" />
    </authentication>

    <!-- Authorization: anonymous users (?) cannot open any page -->
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>

  <!-- Only the user "admin" can open pages in the Admin folder -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow users="admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
